{
  "name": "sda-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project client --project server",
    "test:server": "vitest run --project server",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "db:migrate": "node --conditions=react-server --import tsx src/server/db/migrate.ts",
    "contracts:check": "redocly lint --max-problems 1000 --config redocly.yaml ../../contracts/openapi/public/user-api.yaml ../../contracts/openapi/public/admin-api.yaml && vitest run --project server src/server/http/contract.test.ts",
    "gen:api": "openapi-typescript ../../contracts/openapi/public/user-api.yaml -o src/generated/api/user-api.d.ts && openapi-typescript ../../contracts/openapi/public/admin-api.yaml -o src/generated/api/admin-api.d.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@hookform/resolvers": "^3.9.1",
    "@node-rs/argon2": "2.2.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@tanstack/react-query": "^5.62.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.3",
    "jose": "6.2.12",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "pg": "8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@redocly/cli": "2.64.0",
    "@testcontainers/postgresql": "12.2.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "8.20.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "openapi-typescript": "^7.4.4",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
