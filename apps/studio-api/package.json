{
  "name": "sda-studio-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outdir=dist --sourcemap",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "db:migrate": "tsx src/infrastructure/db/migrate.ts",
    "contracts:check": "redocly lint --max-problems 1000 --config redocly.yaml ../../contracts/openapi/public/user-api.yaml ../../contracts/openapi/public/admin-api.yaml && vitest run --project unit src/http/contract.test.ts",
    "gen:api": "openapi-typescript ../../contracts/openapi/public/user-api.yaml -o src/generated/api/user-api.d.ts && openapi-typescript ../../contracts/openapi/public/admin-api.yaml -o src/generated/api/admin-api.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@node-rs/argon2": "2.2.1",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.3",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "zod": "^3.24.1",
    "hono": "4.13.13",
    "@hono/node-server": "2.1.5"
  },
  "devDependencies": {
    "@redocly/cli": "2.64.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "ajv": "8.20.0",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.17.0",
    "openapi-typescript": "^7.4.4",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8",
    "yaml": "2.9.1",
    "esbuild": "0.28.2",
    "typescript-eslint": "8.71.2"
  }
}
