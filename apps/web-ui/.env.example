# Server-side Studio API address for SSR and local development proxy.
# Docker compose supplies http://studio-api:3001.
STUDIO_API_ORIGIN=http://127.0.0.1:3001

# Must match studio-api; used only for decode-only middleware UX.
AUTH_COOKIE_ACCESS=sda_access

# Chat UI on in-memory mock data instead of the BFF (build time). Off unless exactly "true".
NEXT_PUBLIC_CHAT_MOCK=false
