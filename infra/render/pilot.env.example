# Free pilot env manifest: placeholders only. Real values live in each platform's dashboard and the
# operator's password manager — never in this repo. Generate keys with:
#   python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Every signing key below must be distinct; the runtime refuses colliding keys.

# ---------------------------------------------------------------------------
# Vercel project sda-pilot-web (Root Directory apps/web-ui, build: pnpm gen:api && pnpm build)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CHAT_MOCK=false
# Read at build time: changing it needs a Vercel redeploy.
API_PROXY_ORIGIN=https://<sda-pilot-api>.onrender.com
# Server-side session lookups (admin/dashboard layouts).
STUDIO_API_ORIGIN=https://<sda-pilot-api>.onrender.com

# ---------------------------------------------------------------------------
# Render web service sda-pilot-api (infra/render/studio-api.Dockerfile, health /api/health)
# ---------------------------------------------------------------------------
NODE_ENV=production
# Browser origin: CSRF compares Origin against it.
PRODUCT_BASE_URL=https://<sda-pilot-web>.vercel.app
# Role pilot_product on Neon sda_product (not the owner).
DATABASE_URL=postgresql://pilot_product:<password>@<neon-host>/sda_product?sslmode=require
# Role pilot_kb_studio on Neon sda_runtime.
KNOWLEDGE_DATABASE_URL=postgresql://pilot_kb_studio:<password>@<neon-host>/sda_runtime?sslmode=require
KNOWLEDGE_EMBEDDING_MODELS=gemini-embedding-2
SECRET_KEY=<hex 64>
ADMIN_USERNAME=<admin>
ADMIN_PASSWORD=<strong password>
# Vercel cannot overwrite X-SDA-Client-IP: keep empty so client-supplied values are never trusted.
AUTH_TRUSTED_PROXY_HOSTS=
RUNTIME_INTERNAL_URL=https://<sda-pilot-runtime>.onrender.com
RUNTIME_READY_URL=https://<sda-pilot-runtime>.onrender.com/ready
# Chat: API signs, runtime verifies with RUNTIME_INTERNAL_KEYRING.
PRODUCT_RUNTIME_SIGNING_KEY=<key A>
PRODUCT_RUNTIME_SIGNING_KID=pilot
# Knowledge: API signs, runtime verifies with RUNTIME_STUDIO_KEYRING.
STUDIO_RUNTIME_SIGNING_KEY=<key B>
STUDIO_RUNTIME_SIGNING_KID=studio
# Agent delivery: runtime signs, API verifies.
PRODUCT_DELIVERY_VERIFY_KEY=<key C>
PRODUCT_DELIVERY_VERIFY_KID=runtime
AGENT_DELIVERY_ENVIRONMENT=demo

# ---------------------------------------------------------------------------
# Render web service sda-pilot-runtime (infra/render/agent-runtime.Dockerfile, health /healthz)
# ---------------------------------------------------------------------------
RUNTIME_ENVIRONMENT=demo
# Role pilot_runtime on Neon sda_runtime; SQLAlchemy driver prefix required.
RUNTIME_DATABASE_URL=postgresql+psycopg://pilot_runtime:<password>@<neon-host>/sda_runtime?sslmode=require
RUNTIME_INTERNAL_KEYRING={"pilot":"<key A>"}
RUNTIME_STUDIO_KEYRING={"studio":"<key B>"}
RUNTIME_CURSOR_SIGNING_KEY=<key D>
RUNTIME_AGENT_RELEASE_SOURCE=product
RUNTIME_PRODUCT_URL=https://<sda-pilot-api>.onrender.com
RUNTIME_PRODUCT_SIGNING_KEY=<key C>
RUNTIME_PRODUCT_SIGNING_KID=runtime
# Set in the image; experiences only (the agent comes from Studio).
# RUNTIME_LOCAL_RELEASES_DIR=/releases
GOOGLE_API_KEY=<gemini key>
KNOWLEDGE_EMBEDDING_MODELS=gemini-embedding-2
# Role pilot_indexer (writes chunks/embeddings only). Studio writes make the runtime index in-process, on demand,
# and a woken instance runs once at startup: no worker and no operator step. The indexer engine uses NullPool, so
# it opens a connection per step of a run and keeps none idle afterwards (Neon can suspend).
RUNTIME_KNOWLEDGE_INDEXER_DATABASE_URL=postgresql+psycopg://pilot_indexer:<password>@<neon-host>/sda_runtime?sslmode=require

# ---------------------------------------------------------------------------
# Operator machine only (export in the shell for one command; never on Render/Vercel)
# ---------------------------------------------------------------------------
# Neon owner, direct (non-pooled) connections: provision + migrations.
NEON_OWNER_PRODUCT_URL=postgresql://neondb_owner:<password>@<neon-host>/sda_product?sslmode=require
NEON_OWNER_RUNTIME_URL=postgresql://neondb_owner:<password>@<neon-host>/sda_runtime?sslmode=require
RUNTIME_MIGRATION_DATABASE_URL=postgresql+psycopg://neondb_owner:<password>@<neon-host>/sda_runtime?sslmode=require
RUNTIME_CLEANUP_DATABASE_URL=postgresql+psycopg://pilot_cleanup:<password>@<neon-host>/sda_runtime?sslmode=require
