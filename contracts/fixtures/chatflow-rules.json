{
  "description": "Chatflow rules the runtime enforces and Studio pre-checks. Numeric limits mirror contracts/openapi/schemas/chatflow.yaml; agent-runtime and web-ui each run a parity test against this file.",
  "identifier_pattern": "^[a-z][a-z0-9_]{0,39}$",
  "reserved_node_ids": ["conv", "profile", "result", "router", "sys"],
  "reserved_flow_ids": ["error", "other"],
  "limits": {
    "flows": 10,
    "nodes_per_flow": 50,
    "edges_per_flow": 100,
    "variables": 60,
    "enum_values": 30,
    "flow_examples": 5,
    "variable_description": 300,
    "max_flow_switches": 3
  },
  "variable_constraint_bounds": {
    "min_length": {"minimum": 0, "maximum": 4000},
    "max_length": {"minimum": 0, "maximum": 4000},
    "max_items": {"minimum": 1, "maximum": 100},
    "item_max_length": {"minimum": 1, "maximum": 1000}
  },
  "placeholder_cases": [
    {"text": "{{conv.stage}}", "paths": ["conv.stage"]},
    {"text": "Xin chào {{ sys.turn_index }} và {{result.top_major}}", "paths": ["sys.turn_index", "result.top_major"]},
    {"text": "{{ask.json.major_name}} rồi {{ask.json.major_name}}", "paths": ["ask.json.major_name"]},
    {"text": "{{conv.Stage}}", "paths": []},
    {"text": "{{ask.json.majorName}}", "paths": []},
    {"text": "{{conv._hidden}}", "paths": []},
    {"text": "{{conv.2x}}", "paths": []},
    {"text": "{{conv}}", "paths": []},
    {"text": "{{Conv.stage}}", "paths": []},
    {"text": "{conv.stage}", "paths": []}
  ]
}
